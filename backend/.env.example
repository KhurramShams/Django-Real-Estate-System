# Django Settings Module (Use config.settings.production on Render/production)
DJANGO_SETTINGS_MODULE=config.settings.production

# Django Core Security Configuration
SECRET_KEY=your-secure-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,your-custom-domain.com

# Database Configuration (Aiven PostgreSQL)
# Option A: Single connection URI (Recommended for Render & local)
DATABASE_URL=postgres://avnadmin:your_aiven_password@your-aiven-pg-host.aivencloud.com:12345/defaultdb?sslmode=require

# Option B: Discrete connection parameters (Optional alternative)
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_HOST=your-aiven-pg-host.aivencloud.com
# DB_PORT=12345

# Supabase Storage Integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET_NAME=real-estate-media

# CORS Settings (Include your deployed Vercel frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
